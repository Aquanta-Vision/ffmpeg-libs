prefix=/tmp/ffmpeg-install
exec_prefix=${prefix}
libdir=/tmp/ffmpeg-install/lib
includedir=/tmp/ffmpeg-install/include

Name: libavcodec
Description: FFmpeg codec library
Version: 58.134.100
Requires: 
Requires.private: libswresample >= 3.9.100, libavutil >= 56.70.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -lm -llzma -lz
Cflags: -I${includedir}
